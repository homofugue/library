filters:
  and:
    - note.type == "marginalia"
properties:
  file.name:
    displayName: note
views:
  - type: table
    name: All marginalia
    order:
      - file.name
      - work
      - page
      - edition year
      - themes
      - captured
      - publish
    sort:
      - property: captured
        direction: DESC
