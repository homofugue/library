filters:
  and:
    - note.type == "theme"
views:
  - type: table
    name: Themes
    order:
      - file.name
      - parent
      - related
      - proposed
  - type: table
    name: Proposed (review me)
    filters:
      and:
        - note.proposed == true
    order:
      - file.name
      - related
